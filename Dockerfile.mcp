FROM python:3.12-slim

WORKDIR /app

# Install system build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Pre-install lightweight CPU-only PyTorch (avoids downloading default 1GB+ CUDA binaries from PyPI)
RUN pip install --no-cache-dir --default-timeout=1000 --retries=10 \
    torch --index-url https://download.pytorch.org/whl/cpu

# Copy and install python dependencies with generous network timeout and retries
COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=1000 --retries=10 -r requirements.txt

# Copy codebase
COPY . .

EXPOSE 8000

# Start MCP server with SSE transport accessible on 0.0.0.0:8000
CMD ["python", "mcp_server.py", "--transport", "sse", "--host", "0.0.0.0", "--port", "8000"]
