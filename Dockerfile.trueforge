FROM node:22-bookworm-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install TrueForge CLI globally
RUN npm install -g @truefoundry/trueforge

# Copy catalog configurations into container
COPY trueforge*.yaml ./

ENV HOST=0.0.0.0
ENV PORT=8790
ENV MODEL_CATALOG_PATH=/app/trueforge-models.yaml
ENV SANDBOX_CATALOG_PATH=/app/trueforge-sandbox.yaml
ENV MCP_CATALOG_PATH=/app/trueforge-mcp.yaml

EXPOSE 8790

CMD ["trueforge", "--port", "8790"]
